{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wwn-character-sheet",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://taleswithoutend.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "ai": { "binding": "AI" },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wwn-character-sheet-db",
      "database_id": "8e2bf197-e20f-4ea7-a86f-cab4e1a74699",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "site-creator-r2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMPAIGN_LIVE_SESSION",
        "class_name": "CampaignLiveSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-campaign-live-sessions",
      "new_sqlite_classes": [
        "CampaignLiveSession"
      ]
    }
  ],
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "twe-journal-pr429-preview",
        "database_id": "2b6fce4e-37ed-446e-a809-d9d90cb9e0e9",
        "migrations_dir": "./drizzle"
      }
    ],
    "r2_buckets": [
      {
        "binding": "BUCKET",
        "bucket_name": "twe-journal-pr429-preview"
      }
    ],
    "durable_objects": {
      "bindings": [
        {
          "name": "CAMPAIGN_LIVE_SESSION",
          "class_name": "CampaignLiveSession"
        }
      ]
    },
    "images": {
      "binding": "IMAGES"
    }
  }
}
